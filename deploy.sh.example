#!/bin/sh
# Example deploy script: copy to deploy.sh and set your host.
# Syncs the working tree to the server (removing files deleted here) and
# rebuilds the container there.
# `up -d --build` only replaces the running container once the new image
# builds, so a failed build leaves the current version up.
# Rooms are in memory, so a redeploy ends any games in progress.
set -e

HOST="your-server"            # ssh host or alias from ~/.ssh/config
REMOTE_DIR="/path/to/podside"

rsync -avz --progress --delete \
  --exclude '.git' \
  --exclude '.venv' \
  --exclude '__pycache__' \
  --exclude '.pytest_cache' \
  --exclude 'deploy.sh' \
  ./ "$HOST:$REMOTE_DIR"

ssh "$HOST" "cd '$REMOTE_DIR' && docker compose up -d --build"
